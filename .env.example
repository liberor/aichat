# 服务端口
PORT=8787

# ---- LLM（OpenAI 兼容接口）----
# 单家：填下面三个即可；多家请用 providers.json
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODELS=deepseek-flash,deepseek-v4-pro

# ---- 多 provider（可选）----
# 在项目根目录建 providers.json，格式见 README；存在时覆盖上面的 LLM_*
# PROVIDERS_FILE=providers.json

# ---- 阿里云百炼（Qwen）----
DASHSCOPE_API_KEY=

# ---- Embedding（可选，不配则降级为关键词检索）----
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-v4

# ---- 重排（可选，阿里 gte-rerank）----
# 不填 RERANK_* 时会自动复用 EMBEDDING_* 的地址和 key
# RERANK_BASE_URL=https://dashscope.aliyuncs.com
# RERANK_API_KEY=
RERANK_MODEL=gte-rerank-v2

# ---- OCR（可选，图片型 PDF 兜底）----
# 默认复用 EMBEDDING_* 的地址和 key；模型用 qwen-vl-ocr
# OCR_BASE_URL=
# OCR_API_KEY=
OCR_MODEL=qwen-vl-ocr

# ---- 文生视频（可选，阿里云百炼 · 万相）----
# 和聊天接口不是同一套协议：异步任务，1-5 分钟出结果，按「分辨率 × 时长」计费。
# 默认复用 DASHSCOPE_API_KEY；不填 key 时视频工具不会出现在模型面前。
# VIDEO_API_KEY=
# VIDEO_BASE_URL=https://dashscope.aliyuncs.com
# 注意是 wanx2.1（带 x）；文档模型列表里的 wan2.1-t2v-turbo 接口不认
# 可选模型：turbo 支持 480P/720P 更快；plus 仅 720P 画质更好
VIDEO_MODEL=wanx2.1-t2v-turbo
VIDEO_MODELS=wanx2.1-t2v-turbo,wanx2.1-t2v-plus
VIDEO_SIZE=832*480
# 0 = 不传 duration（部分模型固定 5 秒且不接受该参数）
# VIDEO_DURATION=5
# 单次工具调用最多等多少秒，超时返回 task_id，让模型稍后用 check_video 查
VIDEO_POLL_SECONDS=120
# 1 = 开启 prompt 智能改写（更慢）/ 1 = 加「AI生成」水印
VIDEO_PROMPT_EXTEND=0
VIDEO_WATERMARK=0

# ---- 文生图（可选，阿里云百炼 · 万相）----
# 同样是异步任务，通常 10-30 秒；默认复用 DASHSCOPE_API_KEY。
# 可选模型：wanx2.1-t2i-turbo（更快）/ wanx-v1（老版，支持 style）
IMAGE_MODEL=wanx2.1-t2i-turbo
IMAGE_MODELS=wanx2.1-t2i-turbo,wanx-v1
IMAGE_SIZE=1024*1024
# 每次生成几张（1-4）；wanx-v1 接口默认 n=4，这里强制默认 1，避免一次吃 4 张额度
IMAGE_N=1
IMAGE_POLL_SECONDS=60

# ---- 其他 ----
MOCK=0
# 监听地址：默认所有网卡；只在反向代理后面时建议改成 127.0.0.1
HOST=0.0.0.0
# 是否信任 X-Forwarded-For：默认 false（直连伪造无效）
# 同机 nginx 反代填 loopback；前面一跳远程反代填 1；生产不要用 true
TRUST_PROXY=false
# 数据 / 技能目录；Docker 镜像里默认 /app/data 和 /app/data/skills（同一个卷）
# DATA_DIR=data
# SKILLS_DIR=skills
# 本地调试允许连接内网 MCP server（默认禁止，防 SSRF）
ALLOW_PRIVATE_MCP=0
# Exa MCP 免费额度有限；填了之后服务端连接 mcp.exa.ai 时自动附加 ?exaApiKey=...
# 只放在 .env，不要写进 MCP URL（URL 会返回给前端）
EXA_API_KEY=

# ---- 访问与限流 ----
# 设了就要求输入访问码；多个用逗号分隔，每人一个独立空间
ACCESS_CODE=
# 访问码连续输错多少次后锁定该 IP，以及锁多久（分钟）
AUTH_MAX_FAILS=10
AUTH_LOCK_MINUTES=15
RATE_LIMIT_PER_HOUR=100
DAILY_LIMIT=1000
