  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c cyan,magenta \"node --watch server/index.mjs\" \"vite\"",
    "dev:server": "node --watch server/index.mjs",
