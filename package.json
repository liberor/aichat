    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "gray-matter": "^4.0.3",
    "multer": "^2.0.2",
    "pdf-parse": "^2.4.5",
    "pdf-to-img": "^7.0.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0"
  }
